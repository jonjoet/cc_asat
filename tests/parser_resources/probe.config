// Safety for metadata/echo only. Does not set caps or label requests.
process.executor = 'local'
process.maxForks = 1
executor.queueSize = 1
executor.cpus = 2147483647
executor.memory = '8192 TB'
docker.enabled = false
conda.enabled = false
singularity.enabled = false
report.enabled = false
timeline.enabled = false
dag.enabled = false
trace.enabled = false
params.probe_mode = 'execute'
