/*
 * All publishDir routing for cc_asat.
 *
 * Files published to final_outputs/ are the ELN integration boundary —
 * the complete set of deliverables for a pipeline run.
 */

process {

    withName: 'RAGTAG_CORRECT' {
        publishDir = [
            path: { "${params.outdir}/correct" },
            mode: 'copy',
            saveAs: { filename -> filename.replace('ragtag_correct_out/', '') }
        ]
    }

    withName: 'RAGTAG_SCAFFOLD' {
        publishDir = [
            path: { "${params.outdir}/scaffold" },
            mode: 'copy',
            saveAs: { filename -> filename.replace('ragtag_out/', '') }
        ]
    }

    withName: 'RENAME_RAGTAG_SCAFFOLDS' {
        publishDir = [
            path: { "${params.outdir}/scaffold" },
            mode: 'copy'
        ]
    }

    withName: 'TGS_GAPCLOSER' {
        publishDir = [
            path: { "${params.outdir}/gapclosed" },
            mode: 'copy'
        ]
    }

    withName: 'RAGTAG_PATCH' {
        publishDir = [
            path: { "${params.outdir}/patch" },
            mode: 'copy',
            saveAs: { filename -> filename.replace('ragtag_patch_out/', '') }
        ]
    }

    withName: 'RESTORE_PATCH_SEQNAMES' {
        publishDir = [
            path: { "${params.outdir}/patch" },
            mode: 'copy'
        ]
    }

    withName: 'DNAAPLER' {
        publishDir = [
            path: { "${params.outdir}/dnaapler" },
            mode: 'copy'
        ]
    }

    // Final FASTA — line-wrapped for compatibility with older tools
    withName: 'SEQTK_SEQ' {
        publishDir = [
            path: { "${params.outdir}/final_outputs" },
            mode: 'copy'
        ]
    }

    withName: 'AGAT_FIX_REFERENCE_GFF|AGAT_FIX_VENDOR_GFF' {
        publishDir = [
            path: { "${params.outdir}/annotation_transfer/agat" },
            mode: 'copy'
        ]
    }

    withName: 'FILTER_MEGAGENES_REFERENCE|FILTER_MEGAGENES_VENDOR' {
        publishDir = [
            path: { "${params.outdir}/annotation_transfer/megagene_filter" },
            mode: 'copy'
        ]
    }

    withName: 'LIFTOFF_REFERENCE' {
        publishDir = [
            [
                path: { "${params.outdir}/annotation_transfer/liftoff/reference" },
                mode: 'copy'
            ],
            [
                path: { "${params.outdir}/final_outputs" },
                mode: 'copy',
                saveAs: { filename -> filename.endsWith('_liftoff.gff3') ? filename : null }
            ]
        ]
    }

    withName: 'LIFTOFF_REFERENCE_COPIES' {
        publishDir = [
            path: { "${params.outdir}/annotation_transfer/liftoff/reference_copies" },
            mode: 'copy'
        ]
    }

    withName: 'LIFTOFF_VENDOR' {
        publishDir = [
            path: { "${params.outdir}/annotation_transfer/liftoff/vendor" },
            mode: 'copy'
        ]
    }

    withName: 'FIX_GFF_NAMES_REFERENCE|FIX_GFF_NAMES_REFERENCE_COPIES|FIX_GFF_NAMES_VENDOR' {
        publishDir = [
            path: { "${params.outdir}/annotation_transfer/fix_names" },
            mode: 'copy'
        ]
    }

    withName: 'DIFF_LIFTOFF_COPIES' {
        publishDir = [
            [
                path: { "${params.outdir}/annotation_transfer/copy_analysis" },
                mode: 'copy'
            ],
            [
                path: { "${params.outdir}/final_outputs" },
                mode: 'copy'
            ]
        ]
    }

    withName: 'MERGE_ITERATIVE' {
        publishDir = [
            [
                path: { "${params.outdir}/annotation_transfer/merged" },
                mode: 'copy'
            ],
            [
                path: { "${params.outdir}/final_outputs" },
                mode: 'copy',
                saveAs: { filename -> filename.endsWith('.gff3') ? filename : null }
            ]
        ]
    }

    withName: 'MERGE_FULL' {
        publishDir = [
            [
                path: { "${params.outdir}/annotation_transfer/merged" },
                mode: 'copy'
            ],
            [
                path: { "${params.outdir}/final_outputs" },
                mode: 'copy',
                saveAs: { filename -> filename.endsWith('.gff3') ? filename : null }
            ]
        ]
    }

    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: 'copy'
        ]
    }

}
