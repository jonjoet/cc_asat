            }
            def cap = timeCap.call(params.max_time).toMillis()
            return new nextflow.util.Duration(Math.min(cap, 3600000L))
        }
    }
    withLabel: 'process_low' {
        cpus = {
            def render = { value ->
                value instanceof CharSequence
                    ? value.toString().replace('\\', '\\\\').replace("'", "\\'").replace('\r', '\\r').replace('\n', '\\n').replace('\t', '\\t')
