            }
            def cap = memoryCap.call(params.max_memory).toBytes()
            return new nextflow.util.MemoryUnit(Math.min(cap, 2147483648L))
        }
        time = {
            def render = { value ->
                value instanceof CharSequence
                    ? value.toString().replace('\\', '\\\\').replace("'", "\\'").replace('\r', '\\r').replace('\n', '\\n').replace('\t', '\\t')
