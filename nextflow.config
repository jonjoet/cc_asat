/*
 * Microbial Scaffold Validation Pipeline
 *
 * Configuration file
 */

// ---------------------------------------------------------------------------
// Dynamic resource detection
// ---------------------------------------------------------------------------

def availableCpus = Runtime.runtime.availableProcessors()
def availableMemGB = (Runtime.runtime.maxMemory() / (1024 * 1024 * 1024)).intValue()

// Try to get actual system memory (more accurate than JVM max)
try {
    def memInfo = new File('/proc/meminfo').text
    def matcher = memInfo =~ /MemTotal:\s+(\d+)\s+kB/
    if (matcher.find()) {
        availableMemGB = (matcher.group(1).toLong() / (1024 * 1024)).intValue()
    }
} catch (Exception e) {
    // Fall back to JVM memory if /proc/meminfo unavailable
}

// Reserve 2 CPUs and 2 GB RAM for system
def reservedCpus = 2
def reservedMemGB = 2
def maxCpus = Math.max(1, availableCpus - reservedCpus)
def maxMemGB = Math.max(1, availableMemGB - reservedMemGB)

// Log detected resources
System.out.println("Detected system resources: ${availableCpus} CPUs, ${availableMemGB} GB RAM")
System.out.println("Available for pipeline (after reserving ${reservedCpus} CPUs, ${reservedMemGB} GB): ${maxCpus} CPUs, ${maxMemGB} GB RAM")

params {
    // ---- Required inputs ----
    assembly       = null   // Pre-built de novo assembly FASTA
    reference      = null   // Reference/expected genome FASTA

    // ---- Optional inputs ----
    reads          = null   // Long reads FASTQ(.gz) for gap closing / ragtag correct
    read_type      = 'ont'  // Read type for ragtag correct: 'sr', 'ont', 'corr'
    reference_gff  = null   // Reference GFF for feature annotation (used by QUAST)
    vendor_gff               = null    // Vendor annotation GFF on original assembly contigs
    skip_annotation_transfer = false   // Skip annotation transfer even when reference_gff provided
    skip_merge               = false   // Debug: run both liftoff steps but skip merge (outputs both lifted GFFs separately)
    always_keep_types        = 'transposable_element repeat_region LTR_retrotransposon long_terminal_repeat transposon_fragment'  // Space-separated vendor feature types always transferred regardless of overlap with reference (bacterial users may want: 'insertion_sequence mobile_element prophage')

    // ---- Megagene filtering ----
    megagene_gene_threshold  = 5      // max overlapping genes before flagging as megagene
    max_gene_length_bp       = null   // absolute max gene length in bp (null = disabled)

    // ---- Merge settings (identity-based) ----
    merge_overlap_threshold  = 0.95   // reciprocal CDS overlap fraction for positional match
    coord_preference         = 'reference'  // which source's coordinates for matched pairs
    description_preference   = 'vendor'     // which source's description for matched pairs
    merge_exact_fields       = 'ID Name gene locus_tag'   // attributes matched as whole strings
    merge_word_fields        = 'product description'       // attributes matched word-by-word
    merge_word_min_length    = 4                           // minimum word length for word-field matching
    merge_novel_only         = false                        // novel-only mode: reference unchanged, only unmatched vendor features added (safe for iterative runs)

    // ---- Liftoff settings ----
    liftoff_copies           = true   // run dual liftoff (with and without -copies) for copy analysis
    liftoff_s                = 0.5    // primary alignment identity threshold (Liftoff default)
    liftoff_sc               = 0.95   // copy sequence identity threshold

    // ---- Name cleanup ----
    fix_generic_names        = true   // replace generic Name attrs with informative alternatives post-Liftoff

    // ---- Organism type (required) ----
    organism_type  = null   // Must be 'fungal' or 'bacterial'

    // ---- Control flags ----
    run_correct        = false  // Run ragtag correct before scaffolding (requires reads)
    fill_gaps_from_ref = false  // Fill remaining gaps from reference after gap closing
    reorient_assembly  = null   // Run dnaapler to reorient circular contigs (defaults to true for bacterial, false for fungal; override with --reorient_assembly true/false)

    // ---- GFF fixing (AGAT) ----
    fix_reference_gff = true   // run AGAT fix on reference_gff before use
    fix_vendor_gff    = true   // run AGAT fix on vendor_gff before use

    // ---- General ----
    sample_name    = 'sample'
    outdir         = 'results'

    // ---- Resource limits (auto-detected, can be overridden) ----
    max_cpus   = maxCpus
    max_memory = "${maxMemGB} GB"
    max_time   = '168h'
}

// ---------------------------------------------------------------------------
// Process resource defaults (scaled to available resources)
// ---------------------------------------------------------------------------

process {
    // Global resource caps
    cpus   = { check_max(params.max_cpus, 'cpus') }
    memory = { check_max(params.max_memory, 'memory') }
    time   = { check_max(params.max_time, 'time') }

    withLabel: 'process_low' {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max('4 GB', 'memory') }
        time   = { check_max('1h', 'time') }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max(Math.min(8, maxCpus), 'cpus') }
        memory = { check_max("${Math.min(16, maxMemGB)} GB", 'memory') }
        time   = { check_max('4h', 'time') }
    }
    withLabel: 'process_high' {
        cpus   = { check_max(maxCpus, 'cpus') }
        memory = { check_max("${maxMemGB} GB", 'memory') }
        time   = { check_max('12h', 'time') }
    }
}

// ---------------------------------------------------------------------------
// Function to check resource limits
// ---------------------------------------------------------------------------

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def obj_mem = obj instanceof nextflow.util.MemoryUnit ? obj : new nextflow.util.MemoryUnit(obj.toString())
            def max_mem = new nextflow.util.MemoryUnit(params.max_memory)
            return obj_mem.compareTo(max_mem) > 0 ? max_mem : obj_mem
        } catch (all) {
            println "WARNING: Invalid memory value '${obj}'. Using ${params.max_memory}"
            return new nextflow.util.MemoryUnit(params.max_memory)
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) {
            println "WARNING: Invalid cpus value '${obj}'. Using ${params.max_cpus}"
            return params.max_cpus as int
        }
    } else if (type == 'time') {
        try {
            def obj_time = obj instanceof nextflow.util.Duration ? obj : new nextflow.util.Duration(obj.toString())
            def max_time = new nextflow.util.Duration(params.max_time)
            return obj_time.compareTo(max_time) > 0 ? max_time : obj_time
        } catch (all) {
            println "WARNING: Invalid time value '${obj}'. Using ${params.max_time}"
            return new nextflow.util.Duration(params.max_time)
        }
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

profiles {

    // Recommended: Docker for most processes, conda fallback for processes
    // that lack a suitable multi-tool container.
    standard {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = true
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        conda.enabled = false
        singularity.enabled = false
    }

    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = false
        docker.enabled = false
    }

    // Singularity + conda fallback (analogous to standard but for HPC)
    singularity_conda {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = true
    }

    test {
        params {
            sample_name    = 'test_sample'
            outdir         = 'test_results'
        }
    }
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

// ---------------------------------------------------------------------------
// Manifest
// ---------------------------------------------------------------------------

manifest {
    name            = 'cc_asat'
    author          = 'JT'
    homePage        = ''
    description     = 'Assembly Scaffolding and Annotation Transfer. Designed for microbial genomes.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.8.0'
}
